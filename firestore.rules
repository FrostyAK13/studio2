rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * EMPORER SECURITY ARCHITECTURE
     *
     * Core Philosophy: 
     * This ruleset implements a system-centric security model where the majority of data is 
     * read-only for authenticated users and operational data (Signals) is restricted 
     * to administrative or system-level access.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isExisting() {
      return resource != null;
    }

    // --- COLLECTION RULES ---

    match /stocks/{stockId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      match /historicalPrices/{historicalPriceId} {
        allow get, list: if isSignedIn();
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    match /signals/{signalId} {
      allow get, list: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && isExisting();
      allow delete: if isAdmin() && isExisting();
    }
  }
}
